{
  "name": "trade-finance-demo-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:live": "cross-env NODE_PATH=./node_modules playwright test --config ../e2e-live/playwright.live.config.ts",
    "lint": "eslint .",
    "license-check": "license-checker-rseidelsohn --production --excludePrivatePackages --failOn \"AGPL-1.0;AGPL-3.0;GPL-1.0;GPL-2.0;GPL-3.0;LGPL-2.0;LGPL-2.1;LGPL-3.0;SSPL-1.0\" --summary"
  },
  "dependencies": {
    "vue": "3.5.42",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "cross-env": "^10.1.0",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
